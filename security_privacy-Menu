import socket
import threading
import json
import time
import sys
import platform
import random
import datetime

# --- CONFIGURATION ---
UDP_PORT = 50000          # Port used for PyMessenger presence broadcasting
DEFAULT_TCP_PORT = 50001
HIDE_DURATION = 3600      # 1 hour in seconds


def get_local_ip():
    """Finds the actual local network (LAN/Wi-Fi) IP address of this computer."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))
        ip = s.getsockname()[0]
    except Exception:
        ip = "127.0.0.1"
    finally:
        s.close()
    return ip


class HighSyncDashboard:
    """Integrated HighSync Office Network & Telemetry Dashboard"""
    def __init__(self):
        self.device_name = platform.node() or "Local-Workstation"
        self.local_ip = get_local_ip()
        self.office_name = "HQ-Office-Alpha"
        self.connected_devices = [
            {"name": "MacBook-Pro-M3", "type": "MacBook", "ip": "192.168.1.15", "active": True, "surfing": "api.github.com", "location": "Floor 2, Zone A"},
            {"name": "Windows-Dev-Rig", "type": "Windows PC", "ip": "192.168.1.22", "active": True, "surfing": "teams.microsoft.com", "location": "Floor 2, Zone B"},
            {"name": "Office-iPhone-15", "type": "iPhone", "ip": "192.168.1.45", "active": False, "surfing": "Idle / Standby", "location": "Floor 1, Cafeteria"},
            {"name": "Linux-Server-Node", "type": "Linux Server", "ip": "192.168.1.100", "active": True, "surfing": "internal.docker.registry", "location": "Server Room Rack 3"}
        ]

    def display_loading_screen(self):
        print("\n" + "=" * 60)
        print("          HighSync - Local Office Network Dashboard")
        print("=" * 60)
        print("[*] Initializing secure socket binding...")
        print(f"[*] Host Machine  : {self.device_name} ({self.local_ip})")
        print("[*] Target Network: Wi-Fi SSID (Office_Secure_5G)")
        print("[*] Fetching live office telemetry...")
        
        sys.stdout.write("[")
        sys.stdout.flush()
        for _ in range(20):
            time.sleep(0.03)
            sys.stdout.write("█")
            sys.stdout.flush()
        print("] 100%\n")
        print(f"[+] Successfully connected to Office Group: '{self.office_name}'\n")

    def run_dashboard(self):
        self.display_loading_screen()
        while True:
            current_time = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            print("\n" + "═" * 75)
            print(f"  HIGHSYNC DASHBOARD | Office: {self.office_name} | Time: {current_time}")
            print("═" * 75)
            print(f" {'#':<3} | {'Device Name':<18} | {'Type':<12} | {'IP Address':<14} | {'Status':<8}")
            print("-" * 75)
            
            for idx, dev in enumerate(self.connected_devices, 1):
                status_str = "ACTIVE" if dev["active"] else "IDLE"
                print(f" {idx:<3} | {dev['name']:<18} | {dev['type']:<12} | {dev['ip']:<14} | {status_str:<8}")
            
            print("═" * 75)
            print("HighSync Menu:")
            print(" [1-4] Select a device to view detailed telemetry (Read More)")
            print(" [5]   Invite new device / refresh office roster")
            print(" [6]   Exit HighSync and return to Security Console")
            print("-" * 75)
            
            choice = input("HighSync> ").strip()
            
            if choice in ['1', '2', '3', '4']:
                dev_idx = int(choice) - 1
                self.show_device_details(self.connected_devices[dev_idx])
            elif choice == '5':
                self.invite_device_flow()
            elif choice == '6':
                print("\n[*] Exiting HighSync dashboard...")
                break
            else:
                print("[!] Invalid option. Please choose between 1 and 6.")

    def show_device_details(self, device):
        print("\n" + "┌" + "─" * 50 + "┐")
        print(f"│  DEEP TELEMETRY: {device['name']}".ljust(51) + "│")
        print("├" + "─" * 50 + "┤")
        print(f"│ Device Type         : {device['type']}".ljust(51) + "│")
        print(f"│ IP Address          : {device['ip']}".ljust(51) + "│")
        print(f"│ Network Activity    : {'Active (Transmitting Data)' if device['active'] else 'Idle'}".ljust(51) + "│")
        print(f"│ Activity History    : Surfing on {device['surfing']}".ljust(51) + "│")
        print(f"│ Approximate Location: {device['location']}".ljust(51) + "│")
        print("└" + "─" * 50 + "┘")
        input("\nPress Enter to return to HighSync dashboard...")

    def invite_device_flow(self):
        print("\n--- Invite Device to Office ---")
        new_name = input("Enter new device name (e.g., Office-iPad): ").strip()
        if new_name:
            new_ip = f"192.168.1.{random.randint(50, 199)}"
            new_dev = {
                "name": new_name,
                "type": "New Device",
                "ip": new_ip,
                "active": True,
                "surfing": "auth.highsync.local",
                "location": "Floor 2, Reception Area"
            }
            self.connected_devices.append(new_dev)
            print(f"[+] Success! '{new_name}' ({new_ip}) has been invited and added to {self.office_name}.")
        time.sleep(1.0)


class PyMessengerSecurity:
    def __init__(self):
        self.hostname = socket.gethostname()
        self.local_ip = get_local_ip()
        self.running = True
        
        # Stealth & Privacy state
        self.is_hidden = False
        self.hide_expires_at = 0
        self.stealth_lock = threading.Lock()

        self.node_id = f"{self.local_ip}:{DEFAULT_TCP_PORT}"

    def start(self):
        """Starts the silent background performance booster and stealth manager, then opens the CLI."""
        threading.Thread(target=self._silent_background_optimizer, daemon=True).start()
        threading.Thread(target=self._stealth_broadcast_shield, daemon=True).start()

        self._run_terminal_ui()

    def _silent_background_optimizer(self):
        while self.running:
            try:
                opt_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                opt_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                opt_socket.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 65536)
                opt_socket.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 65536)
                opt_socket.close()
            except Exception:
                pass
            time.sleep(15.0)

    def _stealth_broadcast_shield(self):
        broadcaster = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        broadcaster.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)

        payload = json.dumps({
            "type": "PYMSG_HELLO",
            "id": self.node_id,
            "name": f"{self.hostname} [SECURE]",
            "ip": self.local_ip,
            "port": DEFAULT_TCP_PORT
        }).encode("utf-8")

        while self.running:
            with self.stealth_lock:
                hidden = self.is_hidden
                if hidden and time.time() > self.hide_expires_at:
                    self.is_hidden = False
                    hidden = False
                    sys.stdout.write("\n🛡️ [SECURITY]: Stealth mode expired automatically. You are visible again.\nSecurity> ")
                    sys.stdout.flush()

            if not hidden:
                try:
                    broadcaster.sendto(payload, ("<broadcast>", UDP_PORT))
                except Exception:
                    try:
                        broadcaster.sendto(payload, ("255.255.255.255", UDP_PORT))
                    except Exception:
                        pass
            time.sleep(3.0)
        broadcaster.close()

    def _print_banner(self):
        print("=" * 64)
        print(" PyMessenger Security & Privacy by Agastya Pathak")
        print("=" * 64)
        print(f" Status         : Active (Background Booster Online 🚀)")
        print(f" Stealth Shield : {'HIDDEN (Stealth Active)' if self.is_hidden else 'VISIBLE (Normal)'}")
        print("-" * 64)
        print(" Commands:")
        print("   /hide          -> Hide yourself from PyMessenger Workspace for 1 hour")
        print("   /actv          -> Restore active visible status immediately")
        print("   /highsync      -> Launch HighSync Office Network & Telemetry Dashboard")
        print("   /quit          -> Close Security module")
        print("=" * 64)

    def _run_terminal_ui(self):
        self._print_banner()

        while self.running:
            try:
                user_input = input("Security> ").strip()
                if not user_input:
                    continue

                if user_input.lower() in ("/quit", "/exit"):
                    print("Closing Security & Privacy module...")
                    self.running = False
                    break

                elif user_input.lower() == "/hide":
                    with self.stealth_lock:
                        self.is_hidden = True
                        self.hide_expires_at = time.time() + HIDE_DURATION
                    print("\n🛡️ [SUCCESS]: Hidden for 1 hour.")
                    print("   (Background network optimizer remains active for maximum speed)\n")

                elif user_input.lower() == "/actv":
                    with self.stealth_lock:
                        self.is_hidden = False
                        self.hide_expires_at = 0
                    print("\n🟢 [SUCCESS]: Status restored! Visible on network.\n")

                elif user_input.lower() == "/highsync":
                    print("\n[+] Launching HighSync Dashboard...")
                    highsync = HighSyncDashboard()
                    highsync.run_dashboard()
                    self._print_banner()

                else:
                    print("[!] Unknown command. Use /hide, /actv, /highsync, or /quit.")

            except (KeyboardInterrupt, EOFError):
                print("\nClosing Security & Privacy module...")
                self.running = False
                break


if __name__ == "__main__":
    app = PyMessengerSecurity()
    app.start()
